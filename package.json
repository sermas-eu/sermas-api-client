{
  "name": "@sermas/api-client",
  "version": "1.0.0-alpha.192",
  "description": "Sermas API client",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "require": "./index.cjs",
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sermas-eu/sermas-api-client.git"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsup && cp ./package.json ./README.md ./dist",
    "build:watch": "nodemon --watch ./src --exec 'npm run build'",
    "test": "jest",
    "generate:openapi": "rm -rf ./src/libs/openapi && openapi-ts --enums javascript  --client fetch --input ./openapi.json --output ./src/libs/openapi --name SermasApi",
    "generate:asyncapi": "rm -rf ./src/libs/asyncapi && mkdir -p ./src/libs/asyncapi && node --loader ts-node/esm ./src/asyncapi-generator.ts",
    "generate:asyncapi:dev": "nodemon --watch ./src/asyncapi-generator.ts ./src/asyncapi-generator.ts"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@asyncapi/modelina": "^5.10.1",
    "@asyncapi/parser": "^3.6.6",
    "@hey-api/openapi-ts": "^0.33.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.0.3",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3"
  },
  "author": "",
  "license": "Apache-2.0",
  "overrides": {
    "jsonpath-plus": "^10.3.0",
    "handlebars": "^4.7.10",
    "webapi-parser": {
      "ajv": "^6.14.0"
    },
    "json-schema-migrate": {
      "ajv": "^6.14.0"
    }
  }
}
